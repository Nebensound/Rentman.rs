# Copy to .env (git-ignored) and fill in a real token to run the live API tests.
# Generate the token in Rentman under Configuration -> Integrations.
RENTMAN_API_TOKEN=

# Optional: opt in to generated live tests that read every page from every
# documented top-level collection. This can produce many requests on large accounts.
RENTMAN_LIVE_FULL_COLLECTIONS=

# Optional: ID of a dedicated, non-archived test equipment item. When set, the
# live tests write its current price back unchanged (no-op PUT) and check that
# nothing changed. Leave empty to skip all live writes.
RENTMAN_LIVE_WRITE_EQUIPMENT_ID=
